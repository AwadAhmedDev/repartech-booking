# ── Supabase (required) ──────────────────────────────────────────────────────
VITE_SUPABASE_URL=PASTE_YOUR_SUPABASE_URL_HERE
VITE_SUPABASE_ANON_KEY=PASTE_YOUR_PUBLISHABLE_KEY_HERE

# ── Email notifications (Supabase Edge Function secrets) ─────────────────────
# Set these with: supabase secrets set KEY=value
# They are NOT VITE_ vars — they live in the Supabase dashboard, not .env.local
#
# RESEND_API_KEY=re_...            # Required — get from https://resend.com
# ADMIN_NOTIFICATION_EMAIL=you@domain.com   # Where to send new-booking alerts
# FROM_EMAIL=noreply@yourdomain.com         # Verified sender in Resend
# BUSINESS_NAME=RéparTech                  # Shown in email headers
